# Wahyu Kwan — Portfolio (SPA on Hostinger / Apache)
# Route all non-file, non-directory requests to index.html so React Router
# can handle client-side paths like /projects/maven-fuzzy-factory.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve direct requests for real files and directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls through to the SPA entry.
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache hashed build assets (Vite emits content-hashed filenames).
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
